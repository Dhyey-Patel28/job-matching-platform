datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  candidate
  recruiter
}

enum ProfileMode {
  candidate
  employer
  both
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role
  profileMode  ProfileMode
  createdAt    DateTime     @default(now())

  candidateProfile    CandidateProfile?
  employerProfile     EmployerProfile?
  passwordResetTokens PasswordResetToken[]
}

model CandidateProfile {
  userId    String @id
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String?
  headline  String?
  location  String?
  interests String?
  resumeUrl String?
}

model EmployerProfile {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  roleTitle   String?
  location    String?
  website     String?
  hiringFor   String?
}

// Store job cards as JSON blobs for now.
// We'll seed from sampleJobs on first GET /api/jobs.
model JobListing {
  id        String   @id @default(uuid())
  payload   Json
  createdAt DateTime @default(now())
}

// Store employer cards as JSON blobs for now.
// We'll seed from sampleEmployers on first GET /api/employers.
model EmployerListing {
  id        String   @id @default(uuid())
  payload   Json
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
